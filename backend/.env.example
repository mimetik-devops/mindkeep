DATABASE_URL=postgresql+psycopg://mindkeep:mindkeep@db:5432/mindkeep
WIKI_ROOT=/data
# Hours (UTC) for the overnight passes — the lint (janitorial) and the dream (the
# wiki read against itself). Anything outside 0-23 disables one.
LINT_HOUR=3
DREAM_HOUR=4
# The agents run through OpenRouter: one API, any model behind it.
OPENROUTER_API_KEY=sk-or-...
# The model, an OpenRouter slug. LLM_MODEL is both agents; INGEST_MODEL and
# ASSIST_MODEL override it per agent. It has to take tool calls; for PDFs it has to
# take files too (anthropic/* and google/* do — others need OpenRouter's file-parser
# plugin, not wired here).
LLM_MODEL=anthropic/claude-sonnet-5
# INGEST_MODEL=
# ASSIST_MODEL=
# Long-lived credential for the desktop client. Rotating it revokes every device.
DEVICE_SECRET=change-me-to-32-random-bytes
# Who signs people in. `builtin`: Mindkeep's own e-mail and password accounts — works
# with nothing but this server. `oidc` (the default when unset): an identity provider,
# configured by the AUTH_* settings below.
AUTH_PROVIDER=builtin
# builtin only: signs session tokens. 32+ random characters; rotating it signs everyone out.
AUTH_SECRET=change-me-to-32-random-characters
# --- oidc only, from here ---
# Your identity provider's issuer URL, pinned as the JWT `iss`. Any OIDC provider that
# issues RS256 access tokens and publishes its keys: Kinde, Clerk, Auth0, Keycloak…
AUTH_ISSUER=https://your-org.kinde.com
# Only if your provider sets a meaningful `aud` on access tokens. Blank skips the check.
AUTH_AUDIENCE=
# Only if the keys are not where OIDC discovery says. Blank uses discovery.
AUTH_JWKS_URL=
# The claim that carries roles (used for display now, to gate actions later). Kinde's
# `roles` — a list of {key, name} — is the default; a list of strings or a string also works.
AUTH_ROLE_CLAIM=roles
# The profile (name, email, picture) is read from the access token's standard claims.
# Most providers put those in the ID token only; turn them on for the access token too.
# Where the website is; the desktop client opens its connect page to sign in, and a
# provider's sign-in (Google Drive) lands back there.
WEB_URL=http://localhost:5163
# --- connectors that sign in through a provider ---
# Google (Drive): an OAuth client of type "Web application" in Google Cloud, with the
# Drive API enabled and this redirect URI: <API_PUBLIC_URL>/grants/oauth/drive/callback —
# https://main.mindkeep.io/api/grants/oauth/drive/callback in production,
# http://localhost:5163/api/grants/oauth/drive/callback here. Blank: Drive is listed, not
# offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where a provider sends the browser back: this API's public address. Blank means the
# site's address with /api in front, which is right when Caddy proxies /api.
API_PUBLIC_URL=
# Only when the site calls the API on another origin (it does not when Caddy proxies
# /api): the site's origin(s), comma-separated, for CORS. Blank otherwise.
ALLOWED_ORIGINS=
# The deploy image binds HOST (default 0.0.0.0). Railway's private network is IPv6: HOST=::
