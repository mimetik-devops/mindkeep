DATABASE_URL=postgresql+psycopg://mindstash:mindstash@db:5432/mindstash
WIKI_ROOT=/data
# Hour (UTC) for the nightly lint; anything outside 0-23 disables it.
LINT_HOUR=3
ANTHROPIC_API_KEY=sk-ant-...
# Long-lived credential for the desktop client. Rotating it revokes every device.
DEVICE_SECRET=change-me-to-32-random-bytes
# Kinde tenant root, pinned as the JWT `iss`.
KINDE_ISSUER=https://your-org.kinde.com
# Machine-to-Machine app (Management API: resolving a sub to a person). Blank disables it.
KINDE_M2M_CLIENT_ID=
KINDE_M2M_CLIENT_SECRET=
# custom domains only: keep the canonical https://<workspace>.kinde.com/api
KINDE_MANAGEMENT_API_AUDIENCE=
