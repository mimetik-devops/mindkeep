VITE_API_URL=/api
# --- auth ---
# Which identity provider owns the browser session: kinde | oidc
# (oidc is the standard code flow with PKCE: Keycloak, Auth0, Zitadel, Logto, Kinde itself)
VITE_AUTH_PROVIDER=kinde
# The provider's issuer URL — the same value as the backend's AUTH_ISSUER
VITE_AUTH_ISSUER=https://your-org.kinde.com
# The app registered at the provider as a public single-page client
VITE_AUTH_CLIENT_ID=
# default: the app origin. Must be listed as an allowed callback URL at the provider
VITE_AUTH_REDIRECT_URI=
# default: the app origin. Must be listed as an allowed logout redirect at the provider
VITE_AUTH_LOGOUT_URI=
