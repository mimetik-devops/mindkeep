# The deployed site: the built files, and /api handed to the backend over the private
# network — so the API needs no public address, and the browser sees one origin (no
# CORS). The same shape the dev server has, with Vite's proxy.
#
# PORT: what Railway hands the service. API_UPSTREAM: the backend's private address,
# e.g. http://mindkeep.railway.internal:8000 (the backend must listen on that port).

:{$PORT:5163}

root * /srv
encode gzip

handle_path /api/* {
	reverse_proxy {$API_UPSTREAM:http://backend:8000}
}

handle {
	# Vite names its output by content hash, so /assets/* never changes under a URL and
	# may be kept for good. Everything else — index.html above all — is revalidated on
	# every load (the ETag makes that cheap), so a deploy is seen at once rather than
	# whenever a browser's heuristic guess expires: without a header, an old index.html
	# would point at bundles that are no longer there.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@rest not path /assets/*
	header @rest Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
